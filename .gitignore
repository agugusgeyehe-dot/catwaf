# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env
.env*.local

# Runtime data (SQLite db + Caddy state) — never commit real WAF state.
# WAL mode writes -wal/-shm sidecars next to the database; the -wal file holds
# committed rows that are not yet checkpointed into the .db, so it is just as
# sensitive as the database itself.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
*.sqlite
*.sqlite3

# Generated Caddy config and certs written at runtime
/Caddyfile
/Caddyfile.bak
/Caddyfile.dev
data/certs/
data/coraza-dev-audit.json

# Editor / OS metadata
.vscode/
.idea/
*.swp
Thumbs.db

# Test and coverage artefacts
coverage/
.nyc_output/
test-results/
playwright-report/

# runtime (backend/routes/cloudflare.js gen-cert) — never commit these.
backend/data/

# Common ignores
node_modules
.next/
.DS_Store
dist/
frontend/dist/
*.log

# Service runtime files written next to the database
data/*.pid

# Vendored Caddy binary fetched by scripts/ensure-caddy.js
bin/vendor/

# Local tooling clones that are not part of CatWAF
# Runtime data
/data/*.db
/data/*.sqlite
/data/*.sqlite3
