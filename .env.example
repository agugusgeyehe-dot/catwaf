# Copy this file to .env and adjust as needed. None of these are required
# for local development — CatWAF runs with sane defaults out of the box.
#
# This file holds every secret CatWAF has. Keep it mode 600 (`chmod 600 .env`)
# — CatWAF warns at startup if other users on the machine can read it.

# Which edition is installed: lite or full.
#
#   lite  Caddy + Coraza + CRS, the catwaf CLI and the event database.
#         No HTTP API, no dashboard, no CatAI, no frontend dependencies.
#         `catwaf start` brings up the WAF, not a web server.
#   full  Everything above plus the API, the built dashboard and CatAI.
#
# Written by `catwaf setup --lite|--full`, and read by `npm install` (to decide
# whether to install frontend dependencies at all), by the CLI (to gate
# Full-only commands like `catwaf docker`) and by `catwaf status`.
#
# Leave unset and CatWAF infers it from whether a built dashboard is present,
# so installs that predate this setting keep working.
CATWAF_EDITION=full

# Set to 1 to stop `npm install` downloading a Caddy binary. Use this in
# container images and CI that supply Caddy separately.
# CATWAF_SKIP_CADDY_DOWNLOAD=1

# Port the API listens on (Full only — Lite runs no API server)
PORT=8000

# Your domain, e.g. example.com. `catwaf --setup` asks for this and writes
# it here — the dashboard then lives at catwaf.<DOMAIN> and the API at
# api.catwaf.<DOMAIN> (see src/tui/setup.js and the generated Caddyfile at
# the project root). Leave unset to run locally on http://localhost:3000.
DOMAIN=

# Secret used to sign login JWTs.
#
# Leave this unset for local dev — the backend generates a random secret at
# boot automatically (see middleware/auth.js) and logs a warning that it's
# doing so. That's fine for a laptop, but it means every restart invalidates
# existing sessions, and it's not something to rely on for anything actually
# deployed. Set a real value before that:
#   openssl rand -hex 32
JWT_SECRET=

# Origin(s) allowed to call this API from a browser (comma-separated for
# more than one, e.g. a staging + production dashboard URL).
#
# Leave this unset for local dev — the backend defaults to
# http://localhost:3000 (the Vite dev server) and logs a warning. Set this
# to your real dashboard URL before deploying anywhere reachable from the
# internet — otherwise any page on any origin can call this API from a
# browser holding a valid token.
CORS_ORIGIN=

# Where the SQLite database lives (created automatically if missing)
DB_DIR=./data
# DB_PATH=./data/catwaf.db   # set automatically from DB_DIR; override only
#                             # if you need a single custom file path

# Caddy integration — only relevant if you're running CatWAF in front of a
# real Caddy instance (see docs/reverse-proxy.md).
#
# Leave this UNSET and CatWAF finds the Caddyfile itself, in this order:
#   1. the --config path in caddy's systemd unit, if there is one
#   2. a Caddyfile that already contains CatWAF's markers (i.e. one we
#      have written before), preferring a writable one
#   3. the conventional locations: <project>/Caddyfile, /etc/caddy/Caddyfile,
#      /usr/local/etc/caddy/Caddyfile, and the Homebrew paths on macOS
#   4. <project>/Caddyfile, created on first write
#
# Set it explicitly to override all of that — detection never second-guesses
# an operator who has said where the file is. The chosen path is printed at
# startup, along with a warning if it isn't writable by this user.
CADDYFILE_PATH=
CORAZA_LIST_DIR=/etc/coraza/lists

# How CatWAF reloads Caddy when it changes WAF configuration.
#
# CatWAF does NOT use the Docker socket. It reloads Caddy either by running
# the local `caddy reload` binary (normal host installs) or, when that binary
# isn't present (containers), by POSTing the config to Caddy's own admin API
# at this URL. docker-compose.yml sets this to http://caddy:2019 and keeps
# port 2019 off the published port list, so it stays on the internal network.
CADDY_ADMIN_URL=http://127.0.0.1:2019

# Where Coraza writes its JSON audit log. CatWAF ingests this file to populate
# the dashboard. The DIRECTORY must exist before Caddy starts, or Caddy
# refuses to provision the WAF handler at all.
CORAZA_AUDIT_LOG=/var/log/coraza/audit.json

# Extra origins the dashboard is allowed to call (comma-separated). Only needed
# if the dashboard and API are on different hostnames beyond the standard
# catwaf.<domain> / api.catwaf.<domain> split, which is handled automatically.
CATWAF_CONNECT_SRC=

# Where CatWAF looks for OWASP CRS rule files, used to give `catwaf rules`
# and `catwaf explain` real rule descriptions. Leave unset and CatWAF looks
# in the usual system locations and the Go module cache; if it finds nothing
# it falls back to rules observed in real traffic and says so rather than
# inventing descriptions. CRS itself always runs inside Caddy either way —
# this only affects CatWAF's local metadata index.
CATWAF_CRS_PATH=

# Absolute path to your web root. Without this the Sensitive Files webroot
# scanner has nothing to scan and says so — it does not invent findings.
WEBROOT_PATH=

# CatAI — an optional local assistant built into the dashboard (see the
# cat icon, bottom-right). Runs entirely on this machine via Ollama;
# nothing is sent anywhere. `catwaf --setup` offers to configure this for
# you, including picking a model sized for your hardware — set these by
# hand only if you're doing it outside setup.
#
# Off unless explicitly true. Turning this on with no model pulled just
# makes the assistant report itself unavailable, not error.
CATAI_ENABLED=
# Any tag from https://ollama.com/library/qwen3 works; 1.7b is the
# default setup recommends on anything more than one CPU core.
CATAI_MODEL=qwen3:1.7b
OLLAMA_URL=http://127.0.0.1:11434
# How long the model stays resident in memory between questions. Keeping it
# loaded avoids a 5-15s reload per turn but holds ~1.4GB the whole time. On a
# 1GB VPS set this to 0 and accept the reload — the firewall must win.
CATAI_KEEP_ALIVE=5m
